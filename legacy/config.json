{
  "model": "xtts_v2",
  "output_path": "training_output",

  "data": {
    "datasets": [
      {
        "formatter": "ljspeech",
        "path": "/home/jacob/Documents/GitHub/ML483-ViVoice/baseModelMaker/processed_voice_data",
        "meta_file_train": "/home/jacob/Documents/GitHub/ML483-ViVoice/baseModelMaker/processed_voice_data/metadata.csv"
      }
    ]
  },

  "training": {
    "batch_size": 4,
    "eval_batch_size": 4,

    "grad_accum_steps": 4,

    "num_loader_workers": 4,
    "mixed_precision": true,

    "lr": 0.0001,
    "lr_scheduler": "cosine_with_warmup",
    "lr_warmup_steps": 500,

    "epochs": 350,

    "max_grad_norm": 1.0,
    "optimizer": "adamw",
    "optimizer_params": {
      "betas": [0.9, 0.98],
      "eps": 1e-9,
      "weight_decay": 0.01
    },

    "use_grad_checkpointing": true,
    "save_step": 2000,
    "eval_step": 2000,
    "print_step": 50
  }
}
